# Set runtime/.env.local. Never commit real credentials.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Also accepts NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
SUPABASE_SECRET_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# One explicitly configured business per bot/key in this MVP.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_BUSINESS_ID=
REFERRAL_API_KEY=
REFERRAL_BUSINESS_ID=
REFERRAL_PUBLIC_DIR=
# Private judging demo, single-process only. Disabled until explicitly enabled.
DEMO_ENABLED=false
DEMO_ACCESS_CODE=
DEMO_ORIGIN=http://localhost:3017
ONBOARDING_ORIGIN=https://refella.app
ONBOARDING_DATA_DIR=
TELEGRAM_INTRO_VIDEO_PATH=
# Two-person referral demo API (separate from onboarding).
REFERRAL_LANDING_ORIGIN=https://refella.app
# Optional absolute path on persistent storage; default runtime/.referral-demo/state.json.
REFERRAL_DEMO_DATA=
